rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile pictures
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Conversation attachments
    match /conversations/{conversationId}/{fileName} {
      // Uses cross-service rules to check if user is a participant in the Firestore conversation document
      allow read, write: if request.auth != null && 
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
    }
    
    // Default fallback (block everything else)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
