rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function isAdmin() {
        return !('admins' in resource.data) || request.auth.uid in resource.data.admins;
      }
      function isOnlyUpdatingMessages() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return !affectedKeys.hasAny(['participants', 'admins', 'groupName', 'groupPhoto', 'description', 'createdBy', 'createdAt', 'type']);
      }
      function isLeavingGroup() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return affectedKeys.hasAny(['participants']) &&
               !(request.auth.uid in request.resource.data.participants);
      }

      // When creating, the current user must be in the new participants array
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      // When reading, the current user must be in the existing participants array (or the doc must not exist yet)
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      
      // When updating, the user must be a participant, AND
      // - It's a direct message (no admins), OR
      // - They are an admin, OR
      // - They are just updating the lastMessage metadata, OR
      // - They are leaving the group
      allow update: if isAuthenticated() && isParticipant() && (
        resource.data.type == 'direct' ||
        isAdmin() ||
        isOnlyUpdatingMessages() ||
        isLeavingGroup()
      );
      
      allow delete: if false; // Disallow conversation deletion for now

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        function isEditingOwnText() {
          let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
          return request.resource.data.senderId == request.auth.uid &&
                 affectedKeys.hasOnly(['text', 'edited', 'editedAt']) &&
                 request.time.diff(resource.data.timestamp, SECONDS) < 900;
        }
        function isDeletingOwnMessage() {
          return request.resource.data.senderId == request.auth.uid &&
                 request.resource.data.deletedForEveryone == true;
        }
        
        allow read, create: if isAuthenticated() && isParticipant();
        // Updates that touch 'text' must be the sender editing within 15 minutes,
        // or the sender deleting the message for everyone;
        // other participant updates (readBy, deliveredTo, reactions, pollData, deletedFor) are always allowed.
        allow update: if isAuthenticated() && isParticipant() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['text']) ||
          isEditingOwnText() ||
          isDeletingOwnMessage()
        );
        allow delete: if false; // Disallow message deletion for now
      }
    }
  }
}
